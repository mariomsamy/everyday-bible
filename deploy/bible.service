# sudo cp deploy/bible.service /etc/systemd/system/ && sudo systemctl enable --now bible
# Adjust User and the paths. Needs Node >= 22.5. Only /var/lib/bible (database, texts) is writable; the code is not.
[Unit]
Description=Bible PWA
After=network.target

[Service]
Type=simple
User=bible
WorkingDirectory=/opt/bible
EnvironmentFile=/opt/bible/.env
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
StateDirectory=bible
ReadWritePaths=/var/lib/bible
Environment=DB_PATH=/var/lib/bible/data.sqlite
Environment=TEXTS_DIR=/var/lib/bible/texts
PrivateTmp=true

[Install]
WantedBy=multi-user.target
