ADMIN_TOKEN=
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
SNAP_PIXEL_ID=
GA4_ID=
PORT=8080
HOST=127.0.0.1
DB_PATH=server/data.sqlite
TRUST_PROXY=0
PUBLIC_URL=
# Pixels, AI vendor/model/key and limits are now edited in the admin page (/admin).
# Admin values override the pixel IDs above. The AI key is stored encrypted, derived from ADMIN_TOKEN.
# CDN_FALLBACK=0 removes jsDelivr/GitHub from downloads and the CSP (use once texts are in TEXTS_DIR). Default 1.
# TEXTS_DIR=server/texts
# Docker only: which Bible texts to download in the background on first start: all | ar_kehm,en_web,en_kjv | (empty = none)
# FETCH_TEXTS=ar_kehm,en_web,en_kjv
# Build time: contact address printed in the privacy policy
# VITE_CONTACT_EMAIL=privacy@yourdomain.com
